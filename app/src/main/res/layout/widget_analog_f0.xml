                android:id="@+id/ah1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:dial="@drawable/clock_dial_empty"
                android:hand_hour="@drawable/clock_hour_h1"
                android:hand_minute="@drawable/clock_dial_empty"/>
